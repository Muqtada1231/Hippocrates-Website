{
  // موقع ابوقراط — أصول ساكنة فقط، بلا Worker script.
  // وجود هذا الملف يخلي كل نشرة متطابقة، بدون أي سؤال تفاعلي وقت البناء.
  //
  // "name" لازم يطابق اسم مشروع Cloudflare الموجود أصلاً، وإلا ينفتح Worker
  // جديد وما يتحدّث الموقع الحالي.
  "name": "hippocrates-website",
  "compatibility_date": "2026-09-05",

  "assets": {
    // جذر المستودع، ومعه .assetsignore اللي يستبعد كل ما مو للمتصفح.
    "directory": ".",

    // موقع متعدد الصفحات، مو تطبيق صفحة واحدة: خلي المسار المفقود 404 عادي
    // بدل ما يرجّع index.html.
    "not_found_handling": "none"
  }
}
